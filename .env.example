# Copy this file to .env to turn on live AI for the talking-points chat.
# Without a key the chat runs offline: quick actions use prepared rewrites.
#
# .env is git-ignored. Never commit it, and never put the key in a VITE_ variable:
# anything starting with VITE_ is compiled into the browser bundle.

ANTHROPIC_API_KEY=

# Model used by POST /api/refine-talking-points.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional. How hard the model works: low, medium or high. Lower answers faster.
# ANTHROPIC_EFFORT=low

# Optional. Where the browser finds the API.
# - Local development: leave unset. `npm run dev` serves the API itself at /api.
# - A production build (such as the GitHub Pages site) with this unset has no endpoint
#   and the chat stays offline. Set it at build time to point at a hosted endpoint.
# VITE_AI_ENDPOINT=https://your-api-host.example.com/api

# Optional. Only for the standalone API server (`npm run server`).
# PORT=8787
# CORS_ORIGIN=https://your-name.github.io
